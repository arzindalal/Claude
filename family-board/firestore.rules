rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone signed in (anonymously) can read and write a family they have the ID for.
    // The family ID is a random 32-character string, so it works as the access key.
    match /families/{familyId} {
      allow read, write: if request.auth != null;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
