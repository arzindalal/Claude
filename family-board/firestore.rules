rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // No accounts: the random 32-character family ID in the share link is the access key.
    // A family can be read only by its exact ID; listing all families is not allowed.
    match /families/{familyId} {
      allow get, create, update: if familyId.size() >= 32;
      allow list, delete: if false;

      match /tasks/{taskId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.title is string
                              && request.resource.data.title.size() <= 200
                              && request.resource.data.date is string
                              && request.resource.data.date.size() == 10;
      }
    }
  }
}
